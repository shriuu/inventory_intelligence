// crewai-eval — what "good" means for this crew.
//
// Written from your last run: every criterion below is a task's own
// `expected_output`, which is the bar the crew set for itself. Say what YOU
// want judged and the next `crewai eval` uses it.
//
// Each entry in `criteria` is one yes/no question about the final output, asked
// and answered on its own. Write them so they can be answered from the output
// alone — specific to this crew's job, not "is it well written".
//
// `task_criteria` and `agent_criteria` ask about one step instead: keyed by a
// task's name or an agent's role, judged against that step's own output.
//
// `assertions` are checked in code, never by a judge: contains, not_contains,
// regex, min_length, json_parses.
{
  "schema": "crewai.eval/v1",
  "dataset": [
    {
      "id": "trace-1",
      "inputs": {},
      "expected_output": "A prioritized inventory risk assessment containing the item name, days of supply, supplier lead time, risk explanation, potential business impact, and missing information required for further analysis and send this data to task 2",
      "criteria": [
        "The final output satisfies the task's expected output: A prioritized inventory risk assessment containing the item name, days of supply, supplier lead time, risk explanation, potential business impact, and missing information required for further analysis and send this data to task 2"
      ],
      "task_criteria": {
        "using_the_inventory_risk_task": [
          "The task's output satisfies its expected output: Three prioritized planner recommendations, each with its rationale, expected operational benefit, and required verification."
        ]
      }
    }
  ]
}
